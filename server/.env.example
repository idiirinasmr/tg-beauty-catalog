# Скопировать в server/.env и заполнить. server/.env НЕ коммитить!

# --- База данных (Supabase -> Project Settings -> Database -> Connection string) ---
# DATABASE_URL — через pooler (порт 6543, ?pgbouncer=true), DIRECT_URL — прямое (порт 5432, для миграций)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Supabase Storage (фото) ---
SUPABASE_URL=https://gfylphystvksjlfwqnbp.supabase.co
SUPABASE_SERVICE_KEY=           # Settings -> API -> service_role (секретный!)
SUPABASE_BUCKET=media           # публичный бакет для фото

# --- Сервер ---
PORT=3000
NODE_ENV=production
APP_URL=https://app.example.com # публичный HTTPS-адрес (Mini App, панели, вебхуки)
BOT_MODE=webhook                # webhook (прод) | polling (локально)

# --- Безопасность ---
JWT_SECRET=                     # длинная случайная строка: npm run generate-key
ENCRYPTION_KEY_PATH=/etc/beauty-saas/encryption.key

# --- Лимиты ---
MAX_MASTERS=50

# --- Владелец платформы ---
ADMIN_TELEGRAM_IDS=123456789    # через запятую
ADMIN_BOT_TOKEN=                # бот владельца (уведомления + вход в панели)
ADMIN_BOT_USERNAME=             # без @, для Telegram Login Widget

# --- Платежи ---
PRO_PRICE=500
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
MANUAL_PAYMENT_DETAILS=Перевод на карту 0000 0000 0000 0000 (Сбербанк), в комментарии — ваш Telegram

# --- Настройка под ключ ---
TURNKEY_PRICE=2000              # разовая цена, руб
SUPPORT_TELEGRAM=               # ваш username без @ — мастера пишут вам по заказам

# --- Только для локальной разработки ---
DEV_LOGIN=0                     # 1 = вход без Telegram (только при NODE_ENV=development)
