// Схема БД SaaS-платформы для бьюти-мастеров.
// Таблицы соответствуют разделу 2 docs/BACKEND-PLAN.md.
// Изоляция данных: все таблицы, кроме masters, привязаны к master_id.

generator client {
  provider      = "prisma-client-js"
  // native — локально; rhel-openssl-3.0.x — среда Vercel (Amazon Linux 2023)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 2.1 Мастера
model Master {
  id            String    @id @default(uuid()) @db.Uuid
  // null — мастер «под ключ», заведённый владельцем: Telegram ID появится, когда мастер
  // откроет ссылку t.me/<бот>?start=claim_<claimCode> (см. bot-handlers.js)
  telegramId    BigInt?   @unique @map("telegram_id")
  claimCode     String?   @unique @map("claim_code")
  name          String
  specialty     String    @default("")
  phone         String    @default("")
  email         String    @default("")
  address       String    @default("")
  about         String    @default("")
  avatarUrl     String?   @map("avatar_url")
  logoUrl       String?   @map("logo_url")
  headerName    String?   @map("header_name")
  botToken      String?   @map("bot_token") // AES-256-GCM, см. utils/encrypt.js
  botUsername   String?   @unique @map("bot_username")
  botId         BigInt?   @unique @map("bot_id")
  plan          String    @default("free") // 'free' | 'pro'
  planExpiresAt DateTime? @map("plan_expires_at")
  theme         Json?
  whiteLabel    Boolean   @default(false) @map("white_label")
  statsBookings Int       @default(0) @map("stats_bookings")
  statsViews    Int       @default(0) @map("stats_views") // открытия каталога — для конверсии
  createdAt     DateTime  @default(now()) @map("created_at")

  services   Service[]
  portfolio  Portfolio[]
  bookings   Booking[]
  reviews    Review[]
  faq        Faq[]
  broadcasts Broadcast[]
  clients    Client[]
  payments   Payment[]

  @@map("masters")
}

// 2.2 Услуги
model Service {
  id          String   @id @default(uuid()) @db.Uuid
  masterId    String   @map("master_id") @db.Uuid
  name        String
  description String   @default("")
  price       Int
  duration    Int      @default(60)
  emoji       String   @default("💅")
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  master   Master    @relation(fields: [masterId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([masterId])
  @@map("services")
}

// 2.3 Портфолио
model Portfolio {
  id        String   @id @default(uuid()) @db.Uuid
  masterId  String   @map("master_id") @db.Uuid
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  master Master @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@index([masterId])
  @@map("portfolio")
}

// 2.4 Записи
// appointmentAt — дата/время визита. Клиент оставляет заявку без времени,
// мастер назначает время при подтверждении. От него считаются напоминания.
model Booking {
  id               String    @id @default(uuid()) @db.Uuid
  masterId         String    @map("master_id") @db.Uuid
  serviceId        String?   @map("service_id") @db.Uuid
  serviceName      String    @map("service_name") // копия на момент записи
  servicePrice     Int       @map("service_price")
  clientTelegramId BigInt    @map("client_telegram_id")
  clientName       String    @map("client_name")
  clientUsername   String?   @map("client_username")
  comment          String    @default("")
  status           String    @default("new") // new | confirmed | completed | cancelled
  appointmentAt    DateTime? @map("appointment_at")
  reminder24hSent  Boolean   @default(false) @map("reminder_24h_sent")
  reminder2hSent   Boolean   @default(false) @map("reminder_2h_sent")
  completedAt      DateTime? @map("completed_at")
  reviewRequested  Boolean   @default(false) @map("review_requested")
  createdAt        DateTime  @default(now()) @map("created_at")

  master  Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  reviews Review[]

  @@index([masterId, createdAt])
  @@index([status, appointmentAt])
  @@map("bookings")
}

// 2.5 Отзывы
model Review {
  id         String   @id @default(uuid()) @db.Uuid
  masterId   String   @map("master_id") @db.Uuid
  bookingId  String?  @unique @map("booking_id") @db.Uuid
  clientName String   @map("client_name")
  rating     Int
  text       String   @default("")
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at")

  master  Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([masterId])
  @@map("reviews")
}

// 2.6 FAQ бота-консультанта. question — ключевые слова через запятую.
model Faq {
  id        String @id @default(uuid()) @db.Uuid
  masterId  String @map("master_id") @db.Uuid
  question  String
  answer    String
  sortOrder Int    @default(0) @map("sort_order")

  master Master @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@index([masterId])
  @@map("faq")
}

// 2.7 Рассылки
model Broadcast {
  id              String    @id @default(uuid()) @db.Uuid
  masterId        String    @map("master_id") @db.Uuid
  text            String
  imageUrl        String?   @map("image_url")
  status          String    @default("queued") // queued | sending | done
  sentAt          DateTime? @map("sent_at")
  recipientsCount Int       @default(0) @map("recipients_count")
  createdAt       DateTime  @default(now()) @map("created_at")

  master     Master               @relation(fields: [masterId], references: [id], onDelete: Cascade)
  recipients BroadcastRecipient[]

  @@index([masterId])
  @@map("broadcasts")
}

// Получатели рассылки: статус хранится в БД, чтобы после рестарта
// сервера рассылка продолжилась с места остановки без дублей.
model BroadcastRecipient {
  id          String @id @default(uuid()) @db.Uuid
  broadcastId String @map("broadcast_id") @db.Uuid
  telegramId  BigInt @map("telegram_id")
  status      String @default("pending") // pending | sent | failed

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, telegramId])
  @@index([broadcastId, status])
  @@map("broadcast_recipients")
}

// 2.8 Клиенты мастера
model Client {
  id            String   @id @default(uuid()) @db.Uuid
  masterId      String   @map("master_id") @db.Uuid
  telegramId    BigInt   @map("telegram_id")
  firstName     String   @default("") @map("first_name")
  username      String?
  firstVisitAt  DateTime @default(now()) @map("first_visit_at")
  bookingsCount Int      @default(0) @map("bookings_count")
  isBlocked     Boolean  @default(false) @map("is_blocked") // клиент заблокировал бота

  master Master @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([masterId, telegramId])
  @@map("clients")
}

// 2.9 Платежи за подписку
model Payment {
  id          String    @id @default(uuid()) @db.Uuid
  masterId    String    @map("master_id") @db.Uuid
  amount      Int
  method      String // yukassa | stripe | manual | turnkey
  status      String    @default("pending") // pending | paid | failed
  externalId  String?   @unique @map("external_id")
  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")
  createdAt   DateTime  @default(now()) @map("created_at")
  paidAt      DateTime? @map("paid_at") // по ней считается выручка (заявка могла быть создана раньше)

  master Master @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@index([masterId])
  @@map("payments")
}

// Журнал бэкапов (для /backup и алерта владельцу)
model BackupLog {
  id        String   @id @default(uuid()) @db.Uuid
  ok        Boolean
  sizeBytes BigInt   @default(0) @map("size_bytes")
  message   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("backup_log")
}
